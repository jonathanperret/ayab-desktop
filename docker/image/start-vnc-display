#!/bin/sh
# Start a virtual X display with a window manager, an authenticated VNC server
# on port 5900 and the noVNC browser client on port 6080, then return once the
# display is ready. Shared by the Linux and Wine images.
#
# Environment: DISPLAY (default :99), VNC_PASSWORD (default ayab)
set -eu

: "${DISPLAY:=:99}"
: "${VNC_PASSWORD:=ayab}"
export DISPLAY

# A lock left in the image by a build-time X server would make Xvfb refuse to
# start when its PID happens to be in use; in a fresh container it's stale.
rm -f "/tmp/.X${DISPLAY#:}-lock"

Xvfb "$DISPLAY" -screen 0 1440x900x24 -nolisten tcp &

attempts=0
until xdpyinfo -display "$DISPLAY" >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 50 ]; then
        echo "Xvfb did not become ready" >&2
        exit 1
    fi
    sleep 0.1
done

openbox &

# macOS VNC clients may send Option as Meta_L or Mode_switch. Xvfb only
# has Meta_L as Shift+Alt, so x11vnc would wrap a fake Shift press around it,
# which stops Windows from treating a lone Alt press as "activate the menu
# bar"; Mode_switch has no key at all and would be dropped. Send plain Alt.
x11vnc \
    -display "$DISPLAY" \
    -remap Meta_L-Alt_L,Meta_R-Alt_R,Mode_switch-Alt_L \
    -forever \
    -shared \
    -passwd "$VNC_PASSWORD" \
    -rfbport 5900 \
    -listen 0.0.0.0 &

# noVNC in a browser: websockify serves the client (see install-novnc) and
# bridges its WebSocket to x11vnc, which still checks the VNC password. Its
# per-request log goes to a file to keep the container log readable.
websockify --web /usr/share/novnc 6080 localhost:5900 \
    >/tmp/websockify.log 2>&1 &
